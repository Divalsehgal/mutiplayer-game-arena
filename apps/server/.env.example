# Copy to .env and fill in. Never commit the real .env.
PORT=3030
CORS_ORIGIN=http://localhost:5173
# Number of proxy hops in front of the server (e.g. 1 on Render/Heroku), so rate limits see the real client IP.
# TRUST_PROXY=1

# MongoDB (accounts and sessions). Without it the server still runs, but sign-in won't work.
MONGO_DB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
DB_NAME=game-arena

# Token signing secrets. Required (only the test suite runs without them).
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too

# Google sign-in (same client ID as the client's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
